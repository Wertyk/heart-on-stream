{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!backlog",
      "!!docs",
      "!!notes",
      "!!dist",
      "!!node_modules",
      "!!pnpm-lock.yaml",
      "!!AGENTS.md",
      "!!CLAUDE.md",
      "!!README.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
