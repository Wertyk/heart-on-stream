{
  "name": "heart-on-stream",
  "version": "0.1.0",
  "private": true,
  "description": "Live webcam pulse and breathing overlay for OBS, powered by the Presage SmartSpectra SDK.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && node scripts/launch.mjs",
    "replay": "pnpm build && node scripts/launch.mjs --replay",
    "tune": "node scripts/tune.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0",
    "obs-websocket-js": "5.0.8",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "electron": "45.3.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
